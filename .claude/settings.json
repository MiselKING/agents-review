{
    "permissions": {
        "allow": [
            "Bash(pnpm lint)",
            "Bash(pnpm typecheck)",
            "Bash(pnpm test)",
            "Bash(pnpm test:e2e)",
            "Bash(pnpm test:hooks)",
            "Bash(pnpm format)",
            "Bash(pnpm format:check)",
            "Bash(pnpm codegen)",
            "Bash(pnpm codegen:check)",
            "Bash(pnpm --filter * exec vitest run *)"
        ],
        "ask": [
            "Read(./docs/_project-plan.md)",
            "Read(./docs/AGENTS.md.example)",
            "Edit(**/AGENTS.md)",
            "Edit(**/CLAUDE.md)",
            "Edit(./REVIEW.md)",
            "Edit(./.claude/**)",
            "Edit(./.github/**)",
            "Edit(./.devcontainer/**)",
            "Edit(./pnpm-workspace.yaml)",
            "Edit(./packages/db/src/schema.ts)",
            "Bash(pnpm add *)",
            "Bash(pnpm * add *)",
            "Bash(pnpm update *)",
            "Bash(pnpm * update *)",
            "Bash(pnpm up *)",
            "Bash(pnpm remove *)",
            "Bash(pnpm * remove *)"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.dev)",
            "Read(**/.env.development)",
            "Read(**/.env.prod)",
            "Read(**/.env.production)",
            "Read(**/.env.staging)",
            "Read(**/.env.test)",
            "Read(./docs/private/**)",
            "Edit(./docs/private/**)",
            "Edit(./apps/api/src/generated/**)",
            "Edit(./apps/web/src/gql/**)",
            "Edit(./packages/db/drizzle/**)",
            "Bash(git push --force*)",
            "Bash(git push * --force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push *+*)",
            "Bash(git push * main)",
            "Bash(git push *:main)",
            "Bash(gh pr merge *)",
            "Bash(gh pr review *)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(yarn *)",
            "Bash(*drizzle-kit push*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.ts\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited-file.ts\"",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-before-stop.ts\"",
                        "timeout": 120
                    }
                ]
            }
        ]
    }
}
