#!/bin/sh
# Git runs this before every commit, however the commit was started, so any agent or person gets the
# definition of done from AGENTS.md. `pnpm install` turns it on (the `prepare` script). It checks the
# working tree, not only what is staged.

if [ "$(git branch --show-current)" = main ]; then
  echo 'pre-commit: no commits on main. Create a branch first: git switch -c <type>/<issue-number>-<slug>' >&2
  exit 1
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT

for check in lint typecheck test codegen:check format:check; do
  if ! pnpm "$check" > "$log" 2>&1; then
    tail -n 60 "$log" >&2
    case "$check" in
      codegen:check) fix='Run `pnpm codegen` and include the generated files.' ;;
      format:check) fix='Run `pnpm format`.' ;;
      *) fix='Fix the problems above.' ;;
    esac
    echo "pre-commit: \`pnpm $check\` failed, so nothing was committed. $fix Then commit again." >&2
    exit 1
  fi
done
