# Copy to .env (cp .env.example .env). Every port is read from here, so a
# parallel worktree can move its services by changing these values.
WEB_PORT=5173
API_PORT=4000
MOCK_DESTINATION_PORT=4100
POSTGRES_PORT=5432

# Local Postgres in Docker Compose. These are throwaway local-only credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents_review

# Must match the values above: the env loader doesn't expand ${VAR}, so if you
# change POSTGRES_PORT (or the credentials), change them here too.
# `pnpm db:migrate` stops with an error when the ports don't match.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agents_review
