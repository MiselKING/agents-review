{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "WEB_PORT",
    "API_PORT",
    "MOCK_DESTINATION_PORT",
    "POSTGRES_PORT",
    "DATABASE_URL",
    "MOCK_DESTINATION_FAILURE_RATE",
    "MOCK_DESTINATION_RATE_LIMIT_PER_SECOND",
    "SYNC_DESTINATION_URL"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
